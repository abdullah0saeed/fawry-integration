# ==========================================
# FawryPay Staging Configuration Placeholders
# Replace these with your actual Fawry merchant credentials
# ==========================================

# Port for local Node.js server
PORT=3000

# Fawry Merchant Credentials (Obtained from Fawry Staging Portal / Dashboard)
FAWRY_MERCHANT_CODE=YOUR_MERCHANT_CODE_HERE
FAWRY_SECURE_KEY=YOUR_SECURE_KEY_HERE

# Fawry Staging Base URLs
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_DEV_PORTAL_URL=https://developer.fawrystaging.com

# Server Public URL (Used for Webhook & Return URL)
# If testing locally with Fawry Webhooks, use ngrok or localtunnel URL (e.g. https://xxxx.ngrok-free.app)
APP_BASE_URL=http://localhost:3000

# Pull Model (Scheduled Job) Polling Interval in Cron syntax or seconds
# Runs every 30 seconds by default to automatically check unfulfilled orders
PULL_JOB_INTERVAL_SECONDS=30
ENABLE_PULL_CRON=true
